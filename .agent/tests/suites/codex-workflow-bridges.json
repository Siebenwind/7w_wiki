{
  "suite": "codex-workflow-bridges",
  "description": "Deprecated compatibility alias for adapter-surfaces-contract.",
  "cases": [
    {
      "id": "generated-adapter-files",
      "name": "All Codex-enabled workflow adapters exist as generated skill surfaces",
      "required_regex_by_file": [
        {
          "file": ".agents/skills/session_start/SKILL.md",
          "must_include_regex": [
            "Generated Codex adapter skill\\. Do not edit manually\\.",
            "\\./7w_wiki\\.py start",
            "start --run"
          ]
        },
        {
          "file": ".agents/skills/session_takeover/SKILL.md",
          "must_include_regex": [
            "\\./7w_wiki\\.py takeover",
            "takeover --run"
          ]
        },
        {
          "file": ".agents/skills/session_handover/SKILL.md",
          "must_include_regex": [
            "\\./7w_wiki\\.py handover",
            "handover --run"
          ]
        },
        {
          "file": ".agents/skills/workflow_tech_master/SKILL.md",
          "must_include_regex": [
            "\\./7w_wiki\\.py tech --sync-surfaces",
            "\\./7w_wiki\\.py tech --sync-interop"
          ]
        },
        {
          "file": ".agents/skills/workflow_test_run/SKILL.md",
          "must_include_regex": [
            "\\./7w_wiki\\.py test --suite all",
            "\\./7w_wiki\\.py test --suite adapter-surfaces-contract"
          ]
        },
        {
          "file": ".agents/skills/workflow_forum_search/SKILL.md",
          "must_include_regex": [
            "\\./7w_wiki\\.py scout --forum bekanntmachungen --pages 3",
            "--forum",
            "bekanntmachungen",
            "news",
            "References"
          ]
        }
      ]
    },
    {
      "id": "docs-no-stale-bridge-names",
      "name": "Interop docs no longer mention retired pseudo-bridge names",
      "pattern_check_globs": [
        "docs/Agenten/interop.md",
        "docs/Agenten/workflows.md",
        "System/AGENT_OPERATIONS_HANDBOOK.md",
        "System/Synapse_Board/SY_INTEROP.md"
      ],
      "forbid_regex": [
        "\\bonboarding\\b",
        "\\btest-run\\b",
        "\\binterop-audit\\b"
      ]
    }
  ]
}
