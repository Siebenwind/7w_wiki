{
  "suite": "pages-link-contract",
  "description": "Guard Pages integrity policy, machine snapshots, and advisor freshness signals.",
  "cases": [
    {
      "id": "pages-policy-schema",
      "name": "Pages link policy exists with the required machine-readable fields",
      "required_regex_by_file": [
        {
          "file": ".agent/config/pages_link_policy.json",
          "must_include_regex": [
            "\"version\"",
            "\"updated_at\"",
            "\"entries\"",
            "\"target\"",
            "\"status\"",
            "\"owner\"",
            "\"review_until\""
          ]
        }
      ]
    },
    {
      "id": "pages-validate-json",
      "name": "pages validate emits machine-readable site integrity status and writes a snapshot",
      "cmd": [
        "./7w_wiki.py",
        "pages",
        "validate",
        "--json",
        "--skip-audit"
      ],
      "expect_exit": 0,
      "expect_valid_json": true,
      "expect_json_keys": [
        "generated_at",
        "status",
        "checks",
        "build",
        "pages_health",
        "drift_health"
      ],
      "expect_json_path_exists": [
        "mode",
        "advisory_only",
        "pages_health.last_validated_at",
        "pages_health.targets",
        "pages_health.canonical_wiki_root",
        "pages_health.legacy_wiki_root",
        "pages_health.drift_status",
        "pages_health.drift_counts.docs_only_files",
        "validation_timing_ms.prechecks_total",
        "validation_timing_ms.report_build",
        "validation_timing_ms.total",
        "build.timing_ms.total",
        "pages_health.analysis_cache.docs_link_index.path",
        "pages_health.analysis_cache.docs_link_index.inputs_fingerprint",
        "pages_health.analysis_cache.docs_link_index.hit",
        "pages_health.analysis_cache.canonical_name_index.path",
        "pages_health.analysis_cache.canonical_name_index.inputs_fingerprint",
        "pages_health.analysis_cache.canonical_name_index.hit",
        "pages_health.analysis_cache.tree_drift.path",
        "pages_health.analysis_cache.tree_drift.inputs_fingerprint",
        "pages_health.analysis_cache.tree_drift.hit"
      ],
      "expect_json_path_equals": {
        "mode": "full",
        "advisory_only": false
      },
      "expect_json_path_in": {
        "pages_health.status": ["PASS", "WARN", "FAIL"],
        "pages_health.drift_status": ["PASS", "WARN", "FAIL"]
      },
      "timeout_sec": 300
    },
    {
      "id": "pages-validate-fast-json",
      "name": "pages validate --fast stays advisory-only and reports cached analysis metadata",
      "cmd": [
        "./7w_wiki.py",
        "pages",
        "validate",
        "--json",
        "--fast",
        "--skip-audit"
      ],
      "expect_exit_any": [0, 1],
      "expect_valid_json": true,
      "expect_json_keys": [
        "generated_at",
        "status",
        "checks",
        "build",
        "pages_health"
      ],
      "expect_json_path_exists": [
        "mode",
        "advisory_only",
        "validation_timing_ms.total",
        "build.skipped",
        "pages_health.snapshot_based",
        "pages_health.analysis_cache.docs_link_index.hit",
        "pages_health.analysis_cache.canonical_name_index.hit",
        "pages_health.analysis_cache.tree_drift.hit"
      ],
      "expect_json_path_equals": {
        "mode": "fast",
        "advisory_only": true,
        "build.skipped": true
      },
      "timeout_sec": 120
    },
    {
      "id": "pages-health-snapshot",
      "name": "pages validation snapshot stores the expected Pages health fields",
      "required_regex_by_file": [
        {
          "file": ".agent/data/pages_health.json",
          "must_include_regex": [
            "\"pages_health\"",
            "\"last_validated_at\"",
            "\"unresolved_total\"",
            "\"unallowlisted_total\"",
            "\"canonical_wiki_root\"",
            "\"drift_status\"",
            "\"analysis_cache\""
          ]
        },
        {
          "file": ".agent/data/cache/docs_link_index.json",
          "must_include_regex": [
            "\"version\"",
            "\"generated_at\"",
            "\"inputs_fingerprint\"",
            "\"index\""
          ]
        },
        {
          "file": ".agent/data/cache/canonical_name_index.json",
          "must_include_regex": [
            "\"version\"",
            "\"generated_at\"",
            "\"inputs_fingerprint\"",
            "\"index\""
          ]
        },
        {
          "file": ".agent/data/cache/tree_drift.json",
          "must_include_regex": [
            "\"version\"",
            "\"generated_at\"",
            "\"inputs_fingerprint\"",
            "\"docs_only_files\"",
            "\"legacy_only_files\"",
            "\"content_mismatches\""
          ]
        }
      ]
    },
    {
      "id": "audit-pages-json",
      "name": "audit --pages reports the site integrity bucket and details",
      "cmd": [
        "./7w_wiki.py",
        "audit",
        "--pages",
        "--json"
      ],
      "expect_exit_any": [0, 1],
      "expect_valid_json": true,
      "expect_json_keys": [
        "report_id",
        "categories",
        "details"
      ],
      "expect_json_path_exists": [
        "categories.site_integrity.issues",
        "details.site_integrity.targets",
        "timings_ms.total",
        "timings_ms.content_contract",
        "categories.render_hygiene.issues",
        "categories.contract_violations.issues",
        "categories.split_brain.issues"
      ],
      "timeout_sec": 300
    },
    {
      "id": "advisor-pages-health-json",
      "name": "advisor exposes Pages health and interop freshness fields",
      "cmd": [
        "./7w_wiki.py",
        "advisor",
        "--json"
      ],
      "expect_exit": 0,
      "expect_valid_json": true,
      "expect_json_keys": [
        "pages_health",
        "tech_hygiene",
        "recommendations"
      ],
      "expect_json_path_exists": [
        "pages_health.status",
        "pages_health.last_validated_at",
        "pages_health.drift_status",
        "pages_health.canonical_wiki_root",
        "tech_hygiene.last_sync_interop_at"
      ],
      "expect_stdout": [
        "pages validate --json --strict-links"
      ]
    }
  ]
}
