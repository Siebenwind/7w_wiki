{
  "suite": "process-dispatch-curiosity",
  "description": "Enforces dispatch heartbeat and question-first specialist escalation in core process docs.",
  "cases": [
    {
      "id": "core-process-docs-enforce-dispatch-and-questions",
      "name": "Core workflows/personas require active dispatch usage and specialist-question escalation",
      "required_regex_by_file": [
        {
          "file": ".agent/workflows/ingest_master.md",
          "must_include_regex": [
            "mail inbox --status OPEN",
            "mail post",
            "Fragen statt Raten|Fragepflicht"
          ]
        },
        {
          "file": ".agent/workflows/ingest_master.md",
          "must_include_regex": [
            "Dispatch-Heartbeat",
            "Fragen statt Raten"
          ]
        },
        {
          "file": "System/Templates/INGESTION_REPORT_TEMPLATE.md",
          "must_include_regex": [
            "Auswertungs-ID",
            "Ausgewertet von",
            "Auswertungszeitpunkt",
            "Quality-Profil \\(A/T/K/B/U\\)"
          ]
        },
        {
          "file": ".agent/instructions/persona_ingestor.md",
          "must_include_regex": [
            "3-5 Quellen",
            "Neugier-Regel"
          ]
        },
        {
          "file": "System/Synapse_Board/SY_DISPATCH.md",
          "must_include_regex": [
            "status heartbeats",
            "question-first"
          ]
        },
        {
          "file": "System/AGENT_OPERATIONS_HANDBOOK.md",
          "must_include_regex": [
            "Session-Memory-Protokoll",
            "SESSION_MEMORY_YYYY-MM-DD"
          ]
        },
        {
          "file": ".agent/workflows/handover.md",
          "must_include_regex": [
            "Session-Memory \\(Pflicht\\)",
            "mail post"
          ]
        },
        {
          "file": ".agent/workflows/start.md",
          "must_include_regex": [
            "SESSION_MEMORY_\\*"
          ]
        },
        {
          "file": "AGENTS.md",
          "must_include_regex": [
            "mail inbox --status OPEN",
            "SESSION_MEMORY_\\*",
            "status heartbeats",
            "question-first"
          ]
        },
        {
          "file": ".agent/workflows/tech_master.md",
          "must_include_regex": [
            "Status-Heartbeat|Dispatch-Heartbeat",
            "Session-Memory \\(Pflicht\\)",
            "SESSION_MEMORY_YYYY-MM-DD"
          ]
        }
      ]
    }
  ]
}
