{
  "suite": "reader-stats-contract",
  "description": "Guards the reader-first statistics contract and the machine snapshot surface.",
  "cases": [
    {
      "id": "stats-workflow-contract",
      "name": "Stats workflow documents reader sections and snapshot output",
      "required_regex_by_file": [
        {
          "file": ".agent/workflows/meta_master.md",
          "must_include_regex": [
            "Wiki_Statistiken\\.md",
            "INGESTION_TRACKING_REGISTER\\.md",
            "STATS_SNAPSHOT_latest\\.json"
          ]
        },
        {
          "file": ".agents/skills/stats/SKILL.md",
          "must_include_regex": [
            "Codex Skill: Stats",
            "\\./7w_wiki\\.py stats",
            "reader-facing and machine-readable",
            "STATS_SNAPSHOT_latest\\.json"
          ]
        },
        {
          "file": ".agent/scripts/generate_wiki_stats.py",
          "must_include_regex": [
            "BEGIN GENERATED PUBLIC ACTIVITY",
            "collect_latest_historian_activity",
            "sync_public_activity"
          ]
        },
        {
          "file": "docs/index.md",
          "must_include_regex": [
            "## Was geschieht\\?",
            "BEGIN GENERATED PUBLIC ACTIVITY",
            "Implementierte Neuerungen",
            "Erkenntnisgewinn",
            "Offen geblieben"
          ]
        }
      ]
    },
    {
      "id": "stats-output-contract",
      "name": "Generated stats artifacts expose reader blocks and snapshot keys",
      "required_regex_by_file": [
        {
          "file": "docs/Siebenwind_Wiki/10_Archiv/Wiki_Statistiken.md",
          "must_include_regex": [
            "## 🌍 Welt Heute",
            "## 🔄 Was sich bewegt",
            "## ✅ Qualitaet & Vertrauen",
            "## 🛠️ Werkstattstatus \\(Transparenz\\)",
            "## 🔏 Drift & Provenance"
          ]
        },
        {
          "file": "Logs/Archive/STATS_SNAPSHOT_latest.json",
          "must_include_regex": [
            "\"reader_metrics\"",
            "\"ops_progress\"",
            "\"latest_tests\"",
            "\"generated_at_utc\""
          ]
        }
      ]
    },
    {
      "id": "reader-stats-pages-freshness",
      "name": "Pages contract compares reader statistics with the current publication tree",
      "required_regex_by_file": [
        {
          "file": ".agent/scripts/pages_integrity.py",
          "must_include_regex": [
            "collect_publication_freshness",
            "reader stats article count is stale",
            "./7w_wiki\\.py stats",
            "publication_freshness"
          ]
        },
        {
          "file": ".github/workflows/deploy.yml",
          "must_include_regex": [
            "./7w_wiki\\.py stats",
            "pages validate --json --skip-audit"
          ]
        }
      ]
    }
  ]
}
