{
  "suite": "source-link-hygiene",
  "description": "Guards against recurring source-link defects that break strict docs builds.",
  "cases": [
    {
      "id": "no-source-link-regressions",
      "name": "No double-encoded, file://, or [[index]]-placeholder markdown source links",
      "pattern_check_globs": [
        "docs/Siebenwind_Wiki/**/*.md",
        "Logs/Ingestion/*.md",
        "docs/COORDINATION_HUB.md"
      ],
      "forbid_regex": [
        "\\]\\([^)]*%25[0-9A-Fa-f]{2}\\)",
        "\\]\\(file://",
        "\\]\\([^)]*\\[\\[index\\]\\]%20[^)]*\\)",
        "\\.\\./\\.\\./Quellen/\\[index\\]\\("
      ]
    }
  ]
}
