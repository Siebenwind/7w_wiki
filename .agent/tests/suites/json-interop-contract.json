{
  "cases": [
    {
      "id": "J-001",
      "name": "advisor_json_validity",
      "cmd": [
        "./7w_wiki.py",
        "advisor",
        "--json"
      ],
      "expect_exit": 0,
      "expect_valid_json": true,
      "expect_json_keys": [
        "status",
        "system_health",
        "recommendations"
      ]
    },
    {
      "id": "J-002",
      "name": "audit_json_validity",
      "cmd": [
        "./7w_wiki.py",
        "audit",
        "--json"
      ],
      "expect_exit_any": [
        0,
        1
      ],
      "expect_valid_json": true,
      "expect_json_keys": [
        "report_id",
        "issues_found",
        "details"
      ]
    },
    {
      "id": "J-003",
      "name": "mail_inbox_json_validity",
      "cmd": [
        "./7w_wiki.py",
        "mail",
        "inbox",
        "--status",
        "OPEN",
        "--json"
      ],
      "expect_exit": 0,
      "expect_valid_json": true,
      "expect_json_keys": [
        "status",
        "messages"
      ]
    },
    {
      "id": "J-004",
      "name": "stats_snapshot_validity",
      "cmd": [
        "./7w_wiki.py",
        "stats"
      ],
      "expect_exit": 0,
      "expect_stdout": [
        "Stats snapshot written to"
      ]
    },
    {
      "id": "J-005",
      "name": "stats_json_validity",
      "cmd": [
        "./7w_wiki.py",
        "stats",
        "--json"
      ],
      "expect_exit": 0,
      "expect_valid_json": true,
      "expect_json_keys": [
        "reader_metrics",
        "quality",
        "ops_progress"
      ]
    },
    {
      "id": "J-006",
      "name": "sanitize_json_validity",
      "cmd": [
        "./7w_wiki.py",
        "sanitize",
        "Siebenwind_Wiki/00_Fundament/Magie_Grundlagen.md",
        "--json"
      ],
      "expect_exit_any": [
        0,
        1
      ],
      "expect_valid_json": true,
      "expect_json_keys": [
        "scanned_files",
        "violations_found",
        "details"
      ]
    },
    {
      "id": "J-007",
      "name": "check_json_validity",
      "cmd": [
        "./7w_wiki.py",
        "check",
        "Siebenwind_Wiki/00_Fundament/Magie_Grundlagen.md",
        "--json"
      ],
      "expect_exit_any": [
        0,
        1
      ],
      "expect_valid_json": true,
      "expect_json_keys": [
        "files_checked",
        "files_with_issues",
        "issues"
      ]
    }
