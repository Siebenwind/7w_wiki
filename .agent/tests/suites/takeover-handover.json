{
  "suite": "takeover-handover",
  "description": "Workflow verification for takeover/handover plus mandatory supporting commands.",
  "cases": [
    {
      "id": "cli-help-includes-workflows",
      "name": "CLI help includes takeover/handover commands",
      "cmd": ["./7w_wiki.py", "--help"],
      "expect_exit": 0,
      "expect_stdout": ["takeover", "handover"]
    },
    {
      "id": "takeover-view",
      "name": "Takeover workflow is viewable via CLI",
      "cmd": ["./7w_wiki.py", "takeover"],
      "expect_exit": 0,
      "expect_stdout": ["Workflow: `/takeover`", "mail inbox --status OPEN"]
    },
    {
      "id": "handover-view",
      "name": "Handover workflow is viewable via CLI",
      "cmd": ["./7w_wiki.py", "handover"],
      "expect_exit": 0,
      "expect_stdout": ["Workflow: /handover", "Prioritaet"]
    },
    {
      "id": "handover-auto-dispatch-doc",
      "name": "Handover workflow documents automatic session-memory dispatch defaults",
      "required_regex_by_file": [
        {
          "file": ".agent/workflows/handover.md",
          "must_include_regex": [
            "Auto-Dispatch \\(seit 2026-03-09\\)",
            "--from Oberarchivar --to Coordinator --report-path"
          ]
        },
        {
          "file": "7w_wiki.py",
          "must_include_regex": [
            "def build_handover_mail_post_args\\(",
            "Auto-resolved handover dispatch from"
          ]
        }
      ]
    },
    {
      "id": "dispatch-id-allocation-includes-archive",
      "name": "Dispatch IDs remain unique after DONE messages are rotated",
      "required_regex_by_file": [
        {
          "file": ".agent/scripts/agent_mail.py",
          "must_include_regex": [
            "ARCHIVE_DIR = MAIL_ROOT / \"_archive\"",
            "def all_message_id_paths\\(\\)",
            "for path in all_message_id_paths\\(\\)"
          ]
        }
      ]
    },
    {
      "id": "advisor-readiness",
      "name": "Advisor remains clean after workflow calls",
      "cmd": ["./7w_wiki.py", "advisor"],
      "expect_exit": 0,
      "expect_stdout": ["Dispatch Queue", "Konsistenz-Check"]
    },
    {
      "id": "audit-reporting",
      "name": "Audit command runs and reports current state",
      "cmd": ["./7w_wiki.py", "audit"],
      "expect_exit_any": [0, 1],
      "expect_stdout": ["ERGEBNIS:"]
    }
  ]
}
